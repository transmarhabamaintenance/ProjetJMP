# Copier sous le nom .env pour lancer le backend hors Docker.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=jmp_app
MYSQL_PASSWORD=REMPLACER
MYSQL_DATABASE=jmp
MYSQL_TEST_DATABASE=jmp_test
JWT_SECRET=REMPLACER_PAR_UN_SECRET_LONG_ALEATOIRE
JWT_EXPIRES_IN=8h
JMP_ADMIN_USERNAME=admin
JMP_ADMIN_PASSWORD=CHOISIR_UN_MOT_DE_PASSE
JMP_DEMO_USERNAME=
JMP_DEMO_PASSWORD=
JMP_DEMO_FULLNAME=Agent de démonstration
SERVER_PORT=8080
JMP_CORS_ORIGINS=http://localhost:5173
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
